<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for raw camera images. Loaded through
  FASTRTPS_DEFAULT_PROFILES_FILE (set in docker/Dockerfile).

  Why: a 640x480 bgr8 image is 921,600 bytes. With the default transports it
  exceeds the shared-memory segment and is fragmented over UDP into a 208 KB
  receive buffer, so best-effort frames are dropped. Measured in this container
  at 15 Hz: 230 KB images arrive at 15 Hz, 922 KB images at 2.1 Hz (default)
  or 8.6 Hz (FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA).

  Elements verified against the fastRTPS_profiles.xsd shipped with the Fast DDS
  2.14 in ROS 2 Jazzy.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- Same host: shared memory, sized for several stereo frames in flight. -->
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <!-- Other hosts (robot to laptop): UDP, buffers at the kernel's 4 MB cap. -->
    <transport_descriptor>
      <transport_id>udp_large</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="carma_large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp_large</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
