<?xml version="1.0"?>
<package format="3">
  <name>carma_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic worlds and UGV description for CARMA.</description>
  <maintainer email="none@example.invalid">Erick</maintainer>
  <license>Apache-2.0</license>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <!-- worlds/row_crop.sdf is a template; the launch file expands it by stage. -->
  <exec_depend>xacro</exec_depend>
  <!-- scripts/bgr_relay.py: rgb8 -> bgr8 for the stereo pair. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
