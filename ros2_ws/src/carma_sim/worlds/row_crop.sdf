<?xml version="1.0"?>
<!--
  row_crop.sdf - the default CARMA experimental world: a row-crop field.

  THIS FILE IS A XACRO TEMPLATE, not a world you hand straight to `gz sim`.
  row_crop.launch.py expands it before starting the server. To look at the
  expanded world by hand:

      xacro row_crop.sdf stage:=CANOPY_CLOSURE > /tmp/row_crop.sdf
      gz sim -s -r /tmp/row_crop.sdf

  Why a template. The drift study runs the same routes at two phenological
  stages, and the two runs must differ by one recorded parameter rather than by
  an untracked edit to a forked file (carma_sim/README.md). `stage` is that
  parameter: it takes the names of carma.types.PhenologyStage, the launch file
  validates it against that enum, and it is the only thing that changes between
  the two runs.

  Geometry. Rows run along +x, centred on y = (row - (rows-1)/2) * row_spacing.
  With the defaults below, y = 0 is an alley centre, so a robot spawned at the
  origin facing +x drives down a clear alley at every stage. Row spacing stays
  fixed across stages; canopy width does not, so the alley narrows from 1.35 m
  at VEGETATIVE to 1.00 m at CANOPY_CLOSURE. That narrowing is the point of the
  stage parameter: the routes are identical and the scene is not.

  Row spacing is 1.8 m because the vehicle is 0.72 m wide over its rear tyres.
  At the 1.5 m spacing used while the robot was a narrow differential drive,
  the CANOPY_CLOSURE alley came to 0.70 m and the tractor would not have fitted
  through the world it is meant to be measured in.

  No <include> pulls anything from Fuel. Everything here is inline, because
  AGENTS.md section 2.3 forbids network access at run time.
-->
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== world arguments ==================== -->
  <xacro:arg name="stage" default="VEGETATIVE"/>
  <xacro:arg name="rows" default="8"/>
  <xacro:arg name="row_spacing" default="1.8"/>
  <xacro:arg name="row_length" default="24.0"/>
  <xacro:arg name="obstacles" default="true"/>

  <xacro:property name="stage" value="$(arg stage)"/>
  <xacro:property name="rows" value="$(arg rows)"/>
  <xacro:property name="row_spacing" value="$(arg row_spacing)"/>
  <xacro:property name="row_length" value="$(arg row_length)"/>
  <xacro:property name="obstacles" value="$(arg obstacles)"/>

  <!--
    Crop canopy as a function of phenological stage. Heights and widths are
    metres and are the numbers quoted in carma_sim/README.md; change them here
    and there in the same commit. BARE_SOIL yields no crop model at all.
  -->
  <xacro:property name="crop_height" value="${
      0.00 if stage == 'BARE_SOIL' else
      0.10 if stage == 'EMERGENCE' else
      0.60 if stage == 'VEGETATIVE' else
      1.20 if stage == 'CANOPY_CLOSURE' else
      1.10 if stage == 'SENESCENCE' else
      0.18}"/>
  <xacro:property name="crop_width" value="${
      0.00 if stage == 'BARE_SOIL' else
      0.12 if stage == 'EMERGENCE' else
      0.45 if stage == 'VEGETATIVE' else
      0.80 if stage == 'CANOPY_CLOSURE' else
      0.70 if stage == 'SENESCENCE' else
      0.35}"/>
  <xacro:property name="crop_r" value="${
      0.45 if stage == 'EMERGENCE' else
      0.22 if stage == 'VEGETATIVE' else
      0.12 if stage == 'CANOPY_CLOSURE' else
      0.55 if stage == 'SENESCENCE' else
      0.62}"/>
  <xacro:property name="crop_g" value="${
      0.62 if stage == 'EMERGENCE' else
      0.50 if stage == 'VEGETATIVE' else
      0.35 if stage == 'CANOPY_CLOSURE' else
      0.48 if stage == 'SENESCENCE' else
      0.58}"/>
  <xacro:property name="crop_b" value="${
      0.30 if stage == 'EMERGENCE' else
      0.16 if stage == 'VEGETATIVE' else
      0.10 if stage == 'CANOPY_CLOSURE' else
      0.18 if stage == 'SENESCENCE' else
      0.40}"/>

  <!--
    Each row is a run of segments with gaps, rather than one long box: the gaps
    are what give the stereo pair and the depth camera something with structure
    to look at, and what make a row-following failure visible.
  -->
  <xacro:property name="seg_pitch" value="2.0"/>
  <xacro:property name="seg_length" value="1.8"/>
  <xacro:property name="field_x0" value="2.0"/>
  <xacro:property name="segments" value="${int(row_length / seg_pitch)}"/>

  <xacro:macro name="crop_segments" params="row y i n">
    <xacro:if value="${i &lt; n}">
      <link name="crop_r${row}_s${i}">
        <pose>${field_x0 + i * seg_pitch + seg_length / 2.0} ${y} ${crop_height / 2.0} 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>${seg_length} ${crop_width} ${crop_height}</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>${seg_length} ${crop_width} ${crop_height}</size></box>
          </geometry>
          <material>
            <ambient>${crop_r * 0.4} ${crop_g * 0.4} ${crop_b * 0.4} 1</ambient>
            <diffuse>${crop_r} ${crop_g} ${crop_b} 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
      <xacro:crop_segments row="${row}" y="${y}" i="${i + 1}" n="${n}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="crop_rows" params="row n">
    <xacro:if value="${row &lt; n}">
      <xacro:crop_segments row="${row}"
                           y="${(row - (n - 1) / 2.0) * row_spacing}"
                           i="0" n="${segments}"/>
      <xacro:crop_rows row="${row + 1}" n="${n}"/>
    </xacro:if>
  </xacro:macro>

  <!-- ==================== the world ==================== -->
  <world name="row_crop">

    <!-- Recorded alongside the run: the stage this world was expanded at. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors renders the cameras. ogre2 works headless via EGL. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!--
      1 ms step at real-time factor 1. The cameras run at 15 Hz, which is the
      rate the bridge contract's synchroniser is tuned for.
    -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.62 0.72 0.85 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Soil. Inline, so nothing is fetched from Fuel. -->
    <model name="field_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.18 0.13 0.09 1</ambient>
            <diffuse>0.42 0.31 0.22 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The crop itself. Absent entirely at BARE_SOIL. -->
    <xacro:if value="${crop_height &gt; 0.0}">
      <model name="crop_field">
        <static>true</static>
        <xacro:crop_rows row="0" n="${rows}"/>
      </model>
    </xacro:if>

    <!--
      Field furniture. Stage-independent on purpose: the drift study needs the
      obstacles to be identical between the two stages so that any change in
      behaviour is attributable to the canopy. All of it sits in the y = +/-1.5
      alleys, leaving the y = 0 alley clear for the bring-up drive.
    -->
    <xacro:if value="${obstacles}">
      <model name="rock_a">
        <static>true</static>
        <pose>8.0 1.5 0.14 0 0 0.4</pose>
        <link name="link">
          <collision name="collision">
            <geometry><sphere><radius>0.22</radius></sphere></geometry>
          </collision>
          <visual name="visual">
            <geometry><sphere><radius>0.22</radius></sphere></geometry>
            <material>
              <ambient>0.20 0.19 0.18 1</ambient>
              <diffuse>0.45 0.43 0.40 1</diffuse>
            </material>
          </visual>
        </link>
      </model>

      <model name="irrigation_post">
        <static>true</static>
        <pose>12.0 -1.5 0.60 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><cylinder><radius>0.06</radius><length>1.20</length></cylinder></geometry>
          </collision>
          <visual name="visual">
            <geometry><cylinder><radius>0.06</radius><length>1.20</length></cylinder></geometry>
            <material>
              <ambient>0.25 0.22 0.15 1</ambient>
              <diffuse>0.52 0.45 0.30 1</diffuse>
            </material>
          </visual>
        </link>
      </model>
    </xacro:if>

    <!--
      The robot. Spawned here rather than with ros_gz_sim create, so that a
      world file is a complete description of an episode's starting state.
      z = 0.20 puts the rear wheels on the ground; see models/carma_ugv/model.sdf.
    -->
    <include>
      <uri>model://carma_ugv</uri>
      <name>carma_ugv</name>
      <pose>0 0 0.20 0 0 0</pose>
    </include>

  </world>
</sdf>
