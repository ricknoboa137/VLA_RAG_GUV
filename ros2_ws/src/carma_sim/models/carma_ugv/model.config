<?xml version="1.0"?>
<model>
  <name>carma_ugv</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Erick</name>
    <email>none@example.invalid</email>
  </author>
  <description>
    Tractor-style field UGV for CARMA: rear-wheel drive with Ackermann front
    steering. Carries a 0.12 m baseline stereo pair and a co-located depth
    sensor, and publishes the robot-&gt;bridge topics named in
    ros2_ws/src/carma_bridge/README.md.
  </description>
</model>
