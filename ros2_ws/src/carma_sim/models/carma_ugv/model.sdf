<?xml version="1.0"?>
<!--
  carma_ugv - tractor-style field UGV for CARMA.

  Layout. Rear-wheel drive on two large wheels, front wheels steered through
  Ackermann linkage, as on the physical platform. It is not a differential
  drive: it cannot turn on the spot, and every route has to respect a minimum
  turning radius.

      minimum turning radius = wheel_base / tan(steering_limit)
                             = 0.70 / tan(0.70) = 0.83 m

  That is wider than the crop alley, so the vehicle turns at the headland, not
  between the rows - which is how the real machine is driven.

  Frames
    base_link sits at the centre of the REAR axle, at rear-wheel-radius height.
    Spawn the model with z = 0.20 so the rear wheels touch the ground. The
    front axle is 0.06 m lower in the body frame because the front wheels are
    smaller. x forward, y left, z up (REP 103).

  Chassis geometry, quoted in ros2_ws/src/carma_sim/README.md
    wheel_base           0.700 m   rear axle to front axle
    wheel_separation     0.600 m   rear track, used by the odometry
    kingpin_width        0.520 m   front track
    rear wheel radius    0.200 m
    front wheel radius   0.140 m
    steering_limit       0.700 rad (40 deg)
    width over rear tyres 0.720 m  - this is what has to fit down an alley

  Sensor geometry, unchanged from the differential-drive revision
    stereo baseline   0.120 m   (left y = +0.060, right y = -0.060)
    camera height     0.750 m above ground
    camera pitch      0.150 rad down, so the near rows are in frame
    pixel format      B8G8R8 is rejected by ogre2 at run time, so the cameras
                      render R8G8B8 and scripts/bgr_relay.py swaps the channels
    resolution        640 x 480
    horizontal FOV    1.0472 rad (60 deg)
    fx = fy           554.26 px   = (width / 2) / tan(hfov / 2)
    cx, cy            320.0, 240.0 px
    depth range       0.10 m .. 20.0 m, 32FC1 metres

  The depth camera is co-located with the LEFT camera and shares its
  intrinsics, so depth is registered to /carma/stereo/left/image_raw without a
  reprojection step.

  The AckermannSteering system takes the same geometry_msgs/Twist on
  /carma/cmd_vel and publishes the same nav_msgs/Odometry on /carma/odom as the
  differential drive did, so the bridge contract is untouched by the change of
  running gear.
-->
<sdf version="1.10">
  <model name="carma_ugv">

    <!-- ===================== chassis ===================== -->
    <link name="base_link">
      <inertial>
        <pose>0.32 0 0.14 0 0 0</pose>
        <mass>35.0</mass>
        <inertia>
          <ixx>0.82</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.87</iyy><iyz>0</iyz>
          <izz>2.23</izz>
        </inertia>
      </inertial>

      <!-- Main body, over the rear axle where the mass sits on a tractor. -->
      <collision name="body_collision">
        <pose>0.18 0 0.16 0 0 0</pose>
        <geometry><box><size>0.52 0.42 0.30</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0.18 0 0.16 0 0 0</pose>
        <geometry><box><size>0.52 0.42 0.30</size></box></geometry>
        <material>
          <ambient>0.28 0.29 0.31 1</ambient>
          <diffuse>0.62 0.64 0.67 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>

      <!-- Bonnet, lower and narrower, carrying the camera mount. -->
      <collision name="hood_collision">
        <pose>0.58 0 0.10 0 0 0</pose>
        <geometry><box><size>0.34 0.30 0.18</size></box></geometry>
      </collision>
      <visual name="hood_visual">
        <pose>0.58 0 0.10 0 0 0</pose>
        <geometry><box><size>0.34 0.30 0.18</size></box></geometry>
        <material>
          <ambient>0.30 0.31 0.33 1</ambient>
          <diffuse>0.66 0.68 0.70 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>

      <!-- Front axle beam. Visual only; the kingpins carry the wheels. -->
      <visual name="front_axle_visual">
        <pose>0.70 0 -0.06 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.52</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===================== sensors ===================== -->
    <!--
      0.55 above base_link, and base_link is 0.20 above ground, so the cameras
      sit at the documented 0.75 m.
    -->
    <link name="camera_link">
      <pose relative_to="base_link">0.60 0 0.55 0 0.15 0</pose>
      <inertial>
        <mass>0.30</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="camera_bar_visual">
        <geometry><box><size>0.04 0.18 0.04</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <sensor name="stereo_left" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <topic>/carma/stereo/left/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100.0</far></clip>
        </camera>
      </sensor>

      <sensor name="stereo_right" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <topic>/carma/stereo/right/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100.0</far></clip>
        </camera>
      </sensor>

      <!-- Co-located with stereo_left, same intrinsics: depth is registered. -->
      <sensor name="depth" type="depth_camera">
        <pose>0 0.06 0 0 0 0</pose>
        <topic>/carma/camera/depth</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/camera/depth/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip><near>0.10</near><far>20.0</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ===================== rear wheels, driven ===================== -->
    <link name="rear_left_wheel_link">
      <pose relative_to="base_link">0 0.30 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0336</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0336</iyy><iyz>0</iyz>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.4</mu><mu2>1.1</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_right_wheel_link">
      <pose relative_to="base_link">0 -0.30 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0336</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0336</iyy><iyz>0</iyz>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.4</mu><mu2>1.1</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <!-- ============ front wheels, steered and free-rolling ============ -->
    <!--
      Each side is a kingpin link that rotates about z, carrying a wheel link
      that rotates about y. The steering joints are what AckermannSteering
      drives; the wheel joints are passive and are turned by ground contact.
      Front axle is 0.06 lower than base_link: 0.20 - 0.14 = 0.06.
    -->
    <link name="front_left_kingpin_link">
      <pose relative_to="base_link">0.70 0.26 -0.06 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.10</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_kingpin_link">
      <pose relative_to="base_link">0.70 -0.26 -0.06 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.10</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_kingpin_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <!-- A little beyond steering_limit, so the limit binds, not the joint. -->
        <limit><lower>-0.80</lower><upper>0.80</upper><effort>200</effort></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>

    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_kingpin_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-0.80</lower><upper>0.80</upper><effort>200</effort></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>

    <link name="front_left_wheel_link">
      <pose relative_to="front_left_kingpin_link">0 0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00796</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00796</iyy><iyz>0</iyz>
          <izz>0.0147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_wheel_link">
      <pose relative_to="front_right_kingpin_link">0 0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00796</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00796</iyy><iyz>0</iyz>
          <izz>0.0147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_kingpin_link</parent>
      <child>front_left_wheel_link</child>
      <axis>
        <xyz expressed_in="front_left_kingpin_link">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.005</damping></dynamics>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_kingpin_link</parent>
      <child>front_right_wheel_link</child>
      <axis>
        <xyz expressed_in="front_right_kingpin_link">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.005</damping></dynamics>
      </axis>
    </joint>

    <!-- ===================== running gear ===================== -->
    <!--
      These numbers must match the link poses above. wheel_separation and
      wheel_radius are what the odometry integration uses, so a mismatch is a
      systematic scale error in /carma/odom that corrupts every
      pose-conditioned memory entry without ever looking like a bug.
    -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.52</kingpin_width>
      <steering_limit>0.70</steering_limit>
      <wheel_base>0.70</wheel_base>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.20</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.5</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
      <steer_p_gain>2.0</steer_p_gain>
      <topic>/carma/cmd_vel</topic>
      <odom_topic>/carma/odom</odom_topic>
      <tf_topic>/carma/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/carma/joint_states</topic>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>front_left_steer_joint</joint_name>
      <joint_name>front_right_steer_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
