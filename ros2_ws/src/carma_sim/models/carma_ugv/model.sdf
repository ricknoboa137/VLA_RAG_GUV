<?xml version="1.0"?>
<!--
  carma_ugv - differential-drive field UGV for CARMA.

  Frames
    base_link origin sits on the drive axle, on the robot's centre line, at
    wheel-radius height. Spawn the model with z = 0.10 so the wheels touch the
    ground. x forward, y left, z up (REP 103).

  Sensor geometry, quoted in ros2_ws/src/carma_sim/README.md
    stereo baseline   0.120 m   (left y = +0.060, right y = -0.060)
    camera height     0.750 m above ground
    camera pitch      0.150 rad down, so the near rows are in frame
    pixel format      B8G8R8, so ros_gz publishes bgr8 (the contract), not rgb8
    resolution        640 x 480
    horizontal FOV    1.0472 rad (60 deg)
    fx = fy           554.26 px   = (width / 2) / tan(hfov / 2)
    cx, cy            320.0, 240.0 px
    depth range       0.10 m .. 20.0 m, 32FC1 metres

  The depth camera is co-located with the LEFT camera and shares its
  intrinsics, so depth is registered to /carma/stereo/left/image_raw without a
  reprojection step.

  Gazebo topic names are set to the ROS names in the bridge contract, so the
  parameter_bridge config in config/bridge.yaml is a one-to-one mapping.
-->
<sdf version="1.10">
  <model name="carma_ugv">
    <link name="base_link">
      <inertial>
        <pose>0 0 0.10 0 0 0</pose>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.2</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz>
          <izz>0.52</izz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.20</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.20</size></box></geometry>
        <material>
          <ambient>0.15 0.18 0.22 1</ambient>
          <diffuse>0.25 0.30 0.38 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Sensor mast. Purely structural; the cameras hang off camera_link. -->
      <visual name="mast_visual">
        <pose>0.26 0 0.42 0 0 0</pose>
        <geometry><box><size>0.05 0.30 0.50</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!--
        Rear castor. Friction is zeroed so it slides freely: a spherical castor
        with friction fights the differential drive and biases the odometry.
      -->
      <collision name="castor_collision">
        <pose>-0.22 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="castor_visual">
        <pose>-0.22 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Camera mount. Fixed to the chassis; 0.75 m above ground, pitched down. -->
    <link name="camera_link">
      <pose relative_to="base_link">0.28 0 0.65 0 0.15 0</pose>
      <inertial>
        <mass>0.30</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="camera_bar_visual">
        <geometry><box><size>0.04 0.18 0.04</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <sensor name="stereo_left" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <topic>/carma/stereo/left/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100.0</far></clip>
        </camera>
      </sensor>

      <sensor name="stereo_right" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <topic>/carma/stereo/right/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100.0</far></clip>
        </camera>
      </sensor>

      <!-- Co-located with stereo_left, same intrinsics: depth is registered. -->
      <sensor name="depth" type="depth_camera">
        <pose>0 0.06 0 0 0 0</pose>
        <topic>/carma/camera/depth</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/camera/depth/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip><near>0.10</near><far>20.0</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="wheel_left_link">
      <pose relative_to="base_link">0.15 0.22 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.00336</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00336</iyy><iyz>0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose relative_to="base_link">0.15 -0.22 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.00336</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00336</iyy><iyz>0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!--
      Wheel separation and radius here must match the link poses above. They
      are what the odometry integration uses, so a mismatch shows up as a
      systematic scale error in /carma/odom and silently corrupts every
      pose-conditioned memory entry.
    -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>/carma/cmd_vel</topic>
      <odom_topic>/carma/odom</odom_topic>
      <tf_topic>/carma/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/carma/joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
