<?xml version="1.0"?>
<!--
  so101_follower - the SO-101 follower arm (TheRobotStudio / Hugging Face
  LeRobot) that rides on the front of the CARMA platform.

  Source. Every joint origin, axis, limit and link mass is copied from the
  official URDF, TheRobotStudio/SO-ARM100 Simulation/SO101/so101_new_calib.urdf
  (Apache-2.0). Each link frame here is the URDF child-link frame, posed
  relative to its parent link by the URDF joint origin, so joint angles mean the
  same thing in both files and a LeRobot recording replays here unchanged.

  Geometry. The five arm links are drawn as cylinders from each joint to the
  next and the base as a 110 x 90 x 62.4 mm box. The gripper is the one on the
  assembled follower: the standard SO-101 hinged jaw, drawn and collided with
  the URDF's own meshes of the printed parts (wrist_roll_follower_so101_v1,
  moving_jaw_so101_v1) and of the gripper servo (sts3215_03a_v1), at the
  URDF's poses and with its masses and inertia tensors. The meshes are vendored
  in meshes/ (Apache-2.0, provenance and checksums in meshes/README.md), so
  nothing is fetched at run time (AGENTS.md section 2.3).

  Joint limits. Effort is the 12 V STS3215 stall torque, 30 kg.cm = 2.94 N.m;
  velocity is its no-load speed, 0.222 s per 60 deg = 4.7 rad/s. The URDF's own
  effort and velocity entries are placeholders (10 and 10).

  Topics (gz side; bridged by config/bridge.yaml only when the arm is spawned)
    /carma/arm/<joint>/cmd_pos   gz.msgs.Double, target angle in radians, for all
                                 six joints, gripper included
    /carma/arm/joint_states      gz.msgs.Model, the six joints
    /carma/arm/stereo/{left,right}/image_rgb    gz.msgs.Image, 640 x 480 rgb8, 15 Hz
    /carma/arm/stereo/{left,right}/camera_info  gz.msgs.CameraInfo
  Joints: shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll and
  gripper, all revolute, radians, the URDF's. gripper runs from -0.174533
  (closed) to 1.74533 (fully open), the range LeRobot's 0..100 maps onto.

  Checked in Gazebo Harmonic (2026-11-25), with the arm bolted to the ground at
  the zero pose: from a step command the jaw reaches within 0.01 rad of fully
  open or closed in about 0.3 s (the servo's 4.7 rad/s velocity limit over the
  1.92 rad stroke) and then holds there to 0.0001 rad; a half-open command lands
  within 0.003 rad; over-range commands clamp at the joint limit; with nothing
  commanded the arm drifts under 0.005 rad in 1.8 s. Through
  row_crop.launch.py arm:=true the ROS command reaches the jaw and
  /carma/arm/joint_states reports it under the name gripper.

  Grasp frame: gripper_frame, the URDF's gripper_frame_link, between the jaw
  tips. Reach from the shoulder-lift axis to it is 0.411 m.
-->
<sdf version="1.10">
  <model name="so101_follower">

    <link name="base_link">
      <inertial><pose>0.0388 0 0.0312 0 0 0</pose><mass>0.147</mass>
        <inertia><ixx>0.000147</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000196</iyy><iyz>0</iyz><izz>0.000247</izz></inertia>
      </inertial>
      <visual name="visual"><pose>0.0388 0 0.0312 0 0 0</pose>
        <geometry><box><size>0.11 0.09 0.0624</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <collision name="collision"><pose>0.0388 0 0.0312 0 0 0</pose>
        <geometry><box><size>0.11 0.09 0.0624</size></box></geometry>
      </collision>
    </link>

    <link name="shoulder_link">
      <pose relative_to="base_link">0.0388353 0 0.0624 3.14159 0 -3.14159</pose>
      <inertial><pose>-0.0151996 -0.0091389 -0.0271 0 2.5621 -2.60025</pose><mass>0.100006</mass>
        <inertia><ixx>4.31e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4.31e-05</iyy><iyz>0</iyz><izz>1.62e-05</izz></inertia>
      </inertial>
      <visual name="visual"><pose>-0.0151996 -0.0091389 -0.0271 0 2.5621 -2.60025</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.0648</length></cylinder></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <collision name="collision"><pose>-0.0151996 -0.0091389 -0.0271 0 2.5621 -2.60025</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.0648</length></cylinder></geometry>
      </collision>
    </link>

    <link name="upper_arm_link">
      <pose relative_to="shoulder_link">-0.0303992 -0.0182778 -0.0542 -1.5708 -1.5708 0</pose>
      <inertial><pose>-0.056285 -0.014 0 0 1.5708 -2.89781</pose><mass>0.103</mass>
        <inertia><ixx>0.000124</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000124</iyy><iyz>0</iyz><izz>1.67e-05</izz></inertia>
      </inertial>
      <visual name="visual"><pose>-0.056285 -0.014 0 0 1.5708 -2.89781</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.1160</length></cylinder></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <collision name="collision"><pose>-0.056285 -0.014 0 0 1.5708 -2.89781</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.1160</length></cylinder></geometry>
      </collision>
    </link>

    <link name="lower_arm_link">
      <pose relative_to="upper_arm_link">-0.11257 -0.028 0 0 0 1.5708</pose>
      <inertial><pose>-0.06745 0.0026 0 0 1.5708 3.10306</pose><mass>0.104</mass>
        <inertia><ixx>0.000166</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166</iyy><iyz>0</iyz><izz>1.68e-05</izz></inertia>
      </inertial>
      <visual name="visual"><pose>-0.06745 0.0026 0 0 1.5708 3.10306</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.1350</length></cylinder></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <collision name="collision"><pose>-0.06745 0.0026 0 0 1.5708 3.10306</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.1350</length></cylinder></geometry>
      </collision>
    </link>

    <link name="wrist_link">
      <pose relative_to="lower_arm_link">-0.1349 0.0052 0 0 0 -1.5708</pose>
      <inertial><pose>0 -0.03055 0.00905 0 1.2828 -1.5708</pose><mass>0.079</mass>
        <inertia><ixx>3.31e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.31e-05</iyy><iyz>0</iyz><izz>1.28e-05</izz></inertia>
      </inertial>
      <visual name="visual"><pose>0 -0.03055 0.00905 0 1.2828 -1.5708</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.0637</length></cylinder></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <collision name="collision"><pose>0 -0.03055 0.00905 0 1.2828 -1.5708</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.0637</length></cylinder></geometry>
      </collision>
    </link>

    <link name="gripper_link">
      <pose relative_to="wrist_link">0 -0.0611 0.0181 1.5708 0.0486795 3.14159</pose>
      <inertial><pose>0.000213627 0.000245138 -0.025187 0 0 0</pose><mass>0.087</mass>
        <inertia><ixx>2.75087e-05</ixx><ixy>-3.35241e-07</ixy><ixz>-5.7352e-06</ixz><iyy>4.33657e-05</iyy><iyz>-5.17847e-08</iyz><izz>3.45059e-05</izz></inertia>
      </inertial>
      <!-- The fixed jaw: wrist_roll_follower_so101_v1, with the gripper servo (sts3215_03a_v1)
           inside it. Mesh poses are the URDF's visual origins. -->
      <visual name="wrist_roll_follower"><pose>0 -0.000218214 0.000949706 -3.14159 0 0</pose>
        <geometry><mesh><uri>model://so101_follower/meshes/visual/wrist_roll_follower_so101_v1.stl</uri></mesh></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <!-- BEGIN generated: wrist_roll_follower collision -->
      <collision name="wrist_roll_follower_0"><pose>-0.00260 -0.00200 -0.00559 -3.14159 0 0</pose><geometry><box><size>0.06520 0.05200 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_1"><pose>-0.01045 0.00000 -0.01877 -3.14159 0 0</pose><geometry><box><size>0.04950 0.04800 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_2"><pose>-0.01397 0.00000 -0.03195 -3.14159 0 0</pose><geometry><box><size>0.04245 0.04800 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_3"><pose>-0.02425 -0.00019 -0.04512 -3.14159 0 0</pose><geometry><box><size>0.02190 0.03011 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_4"><pose>-0.02184 -0.00021 -0.05830 -3.14159 0 0</pose><geometry><box><size>0.02049 0.02044 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_5"><pose>-0.01944 -0.00022 -0.07148 -3.14159 0 0</pose><geometry><box><size>0.01568 0.01731 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_6"><pose>-0.01620 -0.00022 -0.08466 -3.14159 0 0</pose><geometry><box><size>0.01259 0.01537 0.01318</size></box></geometry></collision>
      <collision name="wrist_roll_follower_7"><pose>-0.01280 -0.00023 -0.09784 -3.14159 0 0</pose><geometry><box><size>0.00979 0.01280 0.01318</size></box></geometry></collision>
      <!-- END generated: wrist_roll_follower collision -->
      <visual name="gripper_servo"><pose>0.0077 0.0001 -0.0234 -1.5708 0 0</pose>
        <geometry><mesh><uri>model://so101_follower/meshes/visual/sts3215_03a_v1.stl</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <!-- BEGIN generated: gripper_servo collision -->
      <collision name="gripper_servo_0"><pose>0.00770 0.00050 -0.02340 -1.5708 0 0</pose><geometry><box><size>0.04540 0.02480 0.03960</size></box></geometry></collision>
      <!-- END generated: gripper_servo collision -->
      <!--
        Stereo camera on the arm: the project's 3D USB camera, which rides on
        the arm to find and approach targets. 60 mm baseline and 58.9 deg
        horizontal field of view (567.5 px focal length at 640 px, from the
        measured calibration in config/stereo_3dusb.json; the module's listing
        claims 100 deg, which that calibration contradicts). The real camera is
        toed in; these two are parallel.
        Mount: the camera bracket designed for this gripper (2026-11-25), which
        bolts to the fixed jaw's top face with the official wrist-camera
        adapter's two M3 screws. Its lens optical centres are 13.7 mm above that
        face, 60 mm apart across the jaws (left eye at -x), and the camera looks
        along the jaws tilted 15 deg toward them, so both jaw tips sit in view.
        Poses are the bracket's own lens apexes, carried into this link by the
        URDF's wrist_roll_follower transform. rgb8, swapped to bgr8 on
        .../image_raw by bgr_relay like the head camera.
      -->
      <sensor name="arm_stereo_left" type="camera">
        <pose>-0.03000 0.03771 -0.03039 -3.14159 1.30900 -1.57080</pose>
        <topic>/carma/arm/stereo/left/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/arm/stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.02684</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>5.0</far></clip>
        </camera>
      </sensor>
      <sensor name="arm_stereo_right" type="camera">
        <pose>0.03000 0.03771 -0.03039 -3.14159 1.30900 -1.57080</pose>
        <topic>/carma/arm/stereo/right/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/arm/stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.02684</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>5.0</far></clip>
        </camera>
      </sensor>
    </link>

    <link name="moving_jaw_link">
      <pose relative_to="gripper_link">0.0202 0.0188 -0.0234 1.5708 0 0</pose>
      <inertial><pose>-0.00157495 -0.0300244 0.0192755 0 0 0</pose><mass>0.012</mass>
        <inertia><ixx>6.61427e-06</ixx><ixy>-3.19807e-07</ixy><ixz>-5.90717e-09</ixz><iyy>1.89032e-06</iyy><iyz>-1.09945e-07</iyz><izz>5.28738e-06</izz></inertia>
      </inertial>
      <visual name="moving_jaw"><pose>0 0 0.0189 0 0 0</pose>
        <geometry><mesh><uri>model://so101_follower/meshes/visual/moving_jaw_so101_v1.stl</uri></mesh></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
      </visual>
      <!-- BEGIN generated: moving_jaw collision -->
      <collision name="moving_jaw_0"><pose>-0.00699 -0.07625 0.01889 0 0 0</pose><geometry><box><size>0.01062 0.01150 0.01217</size></box></geometry></collision>
      <collision name="moving_jaw_1"><pose>-0.00325 -0.06475 0.01890 0 0 0</pose><geometry><box><size>0.01410 0.01150 0.01472</size></box></geometry></collision>
      <collision name="moving_jaw_2"><pose>-0.00164 -0.05325 0.01890 0 0 0</pose><geometry><box><size>0.01332 0.01150 0.01632</size></box></geometry></collision>
      <collision name="moving_jaw_3"><pose>-0.00103 -0.04175 0.01890 0 0 0</pose><geometry><box><size>0.01454 0.01150 0.01825</size></box></geometry></collision>
      <collision name="moving_jaw_4"><pose>-0.00042 -0.03025 0.01890 0 0 0</pose><geometry><box><size>0.01576 0.01150 0.02213</size></box></geometry></collision>
      <collision name="moving_jaw_5"><pose>-0.00066 -0.01875 0.01890 0 0 0</pose><geometry><box><size>0.01867 0.01150 0.04497</size></box></geometry></collision>
      <collision name="moving_jaw_6"><pose>-0.00005 -0.00725 0.01890 0 0 0</pose><geometry><box><size>0.01990 0.01150 0.04800</size></box></geometry></collision>
      <collision name="moving_jaw_7"><pose>-0.00000 0.00425 0.01890 0 0 0</pose><geometry><box><size>0.02000 0.01150 0.04800</size></box></geometry></collision>
      <!-- END generated: moving_jaw collision -->
    </link>

    <!-- The URDF's gripper joint: the moving jaw swings about its servo horn, from -0.174533
         (closed) to 1.74533 rad (fully open). -->
    <joint name="gripper" type="revolute">
      <parent>gripper_link</parent>
      <child>moving_jaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.174533</lower><upper>1.74533</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="shoulder_pan" type="revolute">
      <parent>base_link</parent>
      <child>shoulder_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.91986</lower><upper>1.91986</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="shoulder_lift" type="revolute">
      <parent>shoulder_link</parent>
      <child>upper_arm_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.74533</lower><upper>1.74533</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="elbow_flex" type="revolute">
      <parent>upper_arm_link</parent>
      <child>lower_arm_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.69</lower><upper>1.69</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="wrist_flex" type="revolute">
      <parent>lower_arm_link</parent>
      <child>wrist_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.65806</lower><upper>1.65806</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="wrist_roll" type="revolute">
      <parent>wrist_link</parent>
      <child>gripper_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-2.74385</lower><upper>2.84121</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- Point between the jaws: the grasp target frame (gripper_frame_link in the URDF). -->
    <frame name="gripper_frame" attached_to="gripper_link">
      <pose>-0.0079 -0.000218121 -0.0981274 0 3.14159 0</pose>
    </frame>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pan</joint_name>
      <topic>/carma/arm/shoulder_pan/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_lift</joint_name>
      <topic>/carma/arm/shoulder_lift/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_flex</joint_name>
      <topic>/carma/arm/elbow_flex/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_flex</joint_name>
      <topic>/carma/arm/wrist_flex/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_roll</joint_name>
      <topic>/carma/arm/wrist_roll/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <!-- The jaw is 12 g, 1.6e-5 kg.m2 about its hinge, about a hundredth of what the arm
         joints carry, so it has its own gains: with the arm's P 8 / D 0.2 the explicit D term
         alone would be unstable at the 1 ms step (D.dt/I = 12). P 4, D 0.005 keep the PID
         stable; the joint's own damping (0.05, applied implicitly by the physics engine)
         settles it in about 25 ms. cmd_max is the servo's stall torque, which is also the
         most it can squeeze an object with. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gripper</joint_name>
      <topic>/carma/arm/gripper/cmd_pos</topic>
      <p_gain>4</p_gain><i_gain>1</i_gain><d_gain>0.005</d_gain>
      <i_max>0.5</i_max><i_min>-0.5</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/carma/arm/joint_states</topic>
      <joint_name>shoulder_pan</joint_name>
      <joint_name>shoulder_lift</joint_name>
      <joint_name>elbow_flex</joint_name>
      <joint_name>wrist_flex</joint_name>
      <joint_name>wrist_roll</joint_name>
      <joint_name>gripper</joint_name>
    </plugin>
  </model>
</sdf>
