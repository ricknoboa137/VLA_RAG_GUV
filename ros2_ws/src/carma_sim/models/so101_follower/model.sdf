    </link>

    <joint name="gripper_minus" type="prismatic">
      <parent>gripper_link</parent>
      <child>gripper_finger_minus</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit><lower>0</lower><upper>0.014</upper><effort>6</effort><velocity>1</velocity></limit>
        <dynamics><damping>0.5</damping><friction>0.02</friction></dynamics>
      </axis>
    </joint>
    <!-- END generated: gripper-fingers -->

    <joint name="shoulder_pan" type="revolute">
      <parent>base_link</parent>
      <child>shoulder_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.91986</lower><upper>1.91986</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="shoulder_lift" type="revolute">
      <parent>shoulder_link</parent>
      <child>upper_arm_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.74533</lower><upper>1.74533</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="elbow_flex" type="revolute">
      <parent>upper_arm_link</parent>
      <child>lower_arm_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.69</lower><upper>1.69</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="wrist_flex" type="revolute">
      <parent>lower_arm_link</parent>
      <child>wrist_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.65806</lower><upper>1.65806</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <joint name="wrist_roll" type="revolute">
      <parent>wrist_link</parent>
      <child>gripper_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-2.74385</lower><upper>2.84121</upper><effort>2.94</effort><velocity>4.7</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- Point between the jaws: the grasp target frame (gripper_frame_link in the URDF). -->
    <frame name="gripper_frame" attached_to="gripper_link">
      <pose>-0.00065 0 -0.101 0 3.14159 0</pose>
    </frame>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pan</joint_name>
      <topic>/carma/arm/shoulder_pan/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_lift</joint_name>
      <topic>/carma/arm/shoulder_lift/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_flex</joint_name>
      <topic>/carma/arm/elbow_flex/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_flex</joint_name>
      <topic>/carma/arm/wrist_flex/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_roll</joint_name>
      <topic>/carma/arm/wrist_roll/cmd_pos</topic>
      <p_gain>8</p_gain><i_gain>0.5</i_gain><d_gain>0.2</d_gain>
      <i_max>1</i_max><i_min>-1</i_min>
      <cmd_max>2.94</cmd_max><cmd_min>-2.94</cmd_min>
    </plugin>

    <!-- The two fingers each have a controller; carma_sim/scripts/gripper_relay.py turns the
         single /carma/arm/gripper/cmd_pos command into a command for each. Gains are for a
         20.7 g slider: 1000 N/m has critical damping 9.1 N.s/m, so 9 is just under it. The
         stiffness is what keeps gravity along the finger axis from sagging it: 0.2 N over
         1000 N/m is 0.2 mm, where 400 N/m left 0.5 mm. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_plus</joint_name>
      <topic>/carma/arm/gripper_plus/cmd_pos</topic>
      <p_gain>1000</p_gain><i_gain>0</i_gain><d_gain>9</d_gain>
      <cmd_max>6</cmd_max><cmd_min>-6</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_minus</joint_name>
      <topic>/carma/arm/gripper_minus/cmd_pos</topic>
      <p_gain>1000</p_gain><i_gain>0</i_gain><d_gain>9</d_gain>
      <cmd_max>6</cmd_max><cmd_min>-6</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/carma/arm/joint_states</topic>
      <joint_name>shoulder_pan</joint_name>
      <joint_name>shoulder_lift</joint_name>
      <joint_name>elbow_flex</joint_name>
      <joint_name>wrist_flex</joint_name>
      <joint_name>wrist_roll</joint_name>
      <joint_name>gripper_plus</joint_name>
      <joint_name>gripper_minus</joint_name>
    </plugin>
  </model>
</sdf>
