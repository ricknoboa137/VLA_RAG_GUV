      <!--
        Stereo camera on the arm: the project's 3D USB camera, which rides on
        the arm to find and approach targets. 60 mm baseline and 58.9 deg
        horizontal field of view (567.5 px focal length at 640 px, from
        config/stereo_3dusb.json). The real camera is toed in; these two are
        parallel. Mount position is an estimate: on the gripper housing,
        looking down the jaws (-z of this link). rgb8, swapped to bgr8 on
        .../image_raw by bgr_relay like the head camera.
      -->
      <sensor name="arm_stereo_left" type="camera">
        <pose>0 0.095 -0.03 0 1.5708 0</pose>
        <topic>/carma/arm/stereo/left/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/arm/stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.0277</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>5.0</far></clip>
        </camera>
      </sensor>
      <sensor name="arm_stereo_right" type="camera">
        <pose>0 0.035 -0.03 0 1.5708 0</pose>
        <topic>/carma/arm/stereo/right/image_rgb</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>/carma/arm/stereo/right/camera_info</camera_info_topic>
